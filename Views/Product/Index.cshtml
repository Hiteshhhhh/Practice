@* filepath: Views/Product/Index.cshtml *@
@model List<ProductModel>
@using Models

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-boxes me-2"></i>Products</h2>
    
    @if (ViewBag.UserRole == "Admin")
    {
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus me-2"></i>Add Product
        </a>
    }
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Created Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.c_name</td>
                        <td>$@product.c_price.ToString("N2")</td>
                        <td>
                            @if (product.c_stock == 0)
                            {
                                <span class="badge bg-danger">Out of Stock</span>
                            }
                            else if (product.c_stock <= 10)
                            {
                                <span class="badge bg-warning">@product.c_stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@product.c_stock</span>
                            }
                        </td>
                        <td>@product.c_created_at.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@product.c_id" 
                                   class="btn btn-sm btn-outline-info">
                                    <i class="fas fa-eye"></i>
                                </a>

                                @if (ViewBag.UserRole == "Admin")
                                {
                                    <a asp-action="Edit" asp-route-id="@product.c_id" 
                                       class="btn btn-sm btn-outline-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@product.c_id" method="post" class="d-inline">
                                        <button type="submit" 
                                                class="btn btn-sm btn-outline-danger" 
                                                onclick="return confirm('Are you sure you want to delete this product?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-box-open fa-5x text-muted mb-3"></i>
        <h4>No Products Found</h4>
        <p class="text-muted">No products have been added yet.</p>
        
        @if (ViewBag.UserRole == "Admin")
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus me-2"></i>Add First Product
            </a>
        }
    </div>
}