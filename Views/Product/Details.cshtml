@* filepath: Views/Product/Details.cshtml *@
@model ProductModel
@using Models

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0"><i class="fas fa-eye me-2"></i>Product Details</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="text-primary">@Model.c_name</h5>
                        <p class="h4 text-success">$@Model.c_price.ToString("N2")</p>
                    </div>
                    <div class="col-md-6 text-end">
                        @if (Model.c_stock == 0)
                        {
                            <span class="badge bg-danger fs-6">Out of Stock</span>
                        }
                        else if (Model.c_stock <= 10)
                        {
                            <span class="badge bg-warning fs-6">@Model.c_stock in stock</span>
                        }
                        else
                        {
                            <span class="badge bg-success fs-6">@Model.c_stock in stock</span>
                        }
                    </div>
                </div>

                <hr>

                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Product ID:</strong> #@Model.c_id</p>
                        <p><strong>Created Date:</strong> @Model.c_created_at.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Products
                    </a>

                    @if (ViewBag.UserRole == "Admin")
                    {
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.c_id" class="btn btn-warning me-2">
                                <i class="fas fa-edit me-2"></i>Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@Model.c_id" method="post" class="d-inline">
                                <button type="submit" 
                                        class="btn btn-danger" 
                                        onclick="return confirm('Are you sure you want to delete this product?')">
                                    <i class="fas fa-trash me-2"></i>Delete
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>