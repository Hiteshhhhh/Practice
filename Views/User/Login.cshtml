@* filepath: Views/User/Login.cshtml *@
@model UserModel
@using Models
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fas fa-sign-in-alt me-2"></i>Login</h4>
            </div>
            <div class="card-body">
                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label asp-for="c_username" class="form-label">Username</label>
                        <input asp-for="c_username" class="form-control" placeholder="Enter username">
                        <span asp-validation-for="c_username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="c_password" class="form-label">Password</label>
                        <input asp-for="c_password" type="password" class="form-control" placeholder="Enter password">
                        <span asp-validation-for="c_password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-sign-in-alt me-2"></i>Login
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a asp-action="Register" class="btn btn-link">Don't have an account? Register</a>
                </div>

                <!-- Test Accounts -->
                <div class="mt-4 p-3 bg-light rounded">
                    <h6>Test Accounts:</h6>
                    <p class="mb-1"><strong>Admin:</strong> admin / admin123</p>
                    <p class="mb-0"><strong>User:</strong> user / user123</p>
                </div>
            </div>
        </div>
    </div>
</div>